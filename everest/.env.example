# ─── Obligatorias ───────────────────────────────────────────────────────────
# PostgreSQL (Supabase recomendado). Usa la conexión DIRECTA o el "session pooler"
# (puerto 5432): el canal en vivo usa LISTEN/NOTIFY, que no funciona con el
# "transaction pooler" (puerto 6543).
DATABASE_URL=postgres://USUARIO:CONTRASEÑA@HOST:5432/postgres
# Secreto para firmar sesiones del equipo y la identidad anónima de invitados (≥ 32 caracteres).
#   openssl rand -base64 48
SESSION_SECRET=
# URL pública única de la plataforma (la que codifica el QR).
PUBLIC_URL=https://everest.ejemplo.mx

# ─── Opcionales ─────────────────────────────────────────────────────────────
# Conexión distinta solo para LISTEN (si DATABASE_URL apunta a un pooler de transacciones).
# DATABASE_LISTEN_URL=
# DATABASE_SSL=disable          # solo para Postgres local sin TLS
# DATABASE_POOL_MAX=10

# Render de postales (FFmpeg en el servidor)
# RENDER_WORKER=on              # "off" para no procesar postales en esta instancia
# RENDER_CONCURRENCY=1          # postales simultáneas por instancia (≈1 por cada 2 vCPU)
# RENDER_MAX_QUEUE=60           # tamaño máximo de la fila antes de pedir reintento
# RENDER_DIR=.data/renders      # dónde se guardan MP4/PNG (volumen persistente)
# RENDER_TTL_HOURS=72           # limpieza automática de archivos
# POSTAL_X264_PRESET=medium     # "veryfast" en servidores pequeños
# FFMPEG_PATH=ffmpeg
# POSTAL_SOURCE_VIDEO=assets/video/everest-original.mp4

# Guía paso a paso: docs/SUPABASE.md   ·   Verificación: npm run supabase:check

# ─── Obligatorias ───────────────────────────────────────────────────────────
# PostgreSQL de Supabase: Project → botón "Connect" → "Session pooler" (puerto 5432).
# Sustituye [YOUR-PASSWORD] por la contraseña de la base de datos del proyecto.
# El canal en vivo usa LISTEN/NOTIFY, que NO funciona con el "transaction pooler" (6543).
DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:TU_CONTRASEÑA@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Conexiones simultáneas de la app (el session pooler gratuito admite ~15 en total).
DATABASE_POOL_MAX=8
# Secreto para firmar sesiones del equipo y la identidad anónima de invitados (≥ 32 caracteres).
#   openssl rand -base64 48
SESSION_SECRET=
# URL pública única de la plataforma (la que codifica el QR).
PUBLIC_URL=https://everest.ejemplo.mx

# ─── Supabase Storage (recomendado para las postales) ──────────────────────
# Project Settings → API: "Project URL" y la llave secreta (service_role o sb_secret_…).
# SOLO en el servidor: nunca la pongas en variables NEXT_PUBLIC_ ni en el navegador.
# Si las defines, las postales se guardan en un bucket PRIVADO y se descargan con enlaces
# firmados de 10 minutos; el servidor de la app no necesita disco persistente.
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=postales

# ─── Opcionales ─────────────────────────────────────────────────────────────
# Conexión distinta solo para LISTEN (p. ej. la conexión directa db.TU_PROJECT_REF.supabase.co:5432,
# o el session pooler si DATABASE_URL usa el transaction pooler 6543).
# DATABASE_LISTEN_URL=
# DATABASE_SSL=disable          # solo para Postgres local sin TLS
# DATABASE_POOL_MAX=10

# Render de postales (FFmpeg en el servidor)
# RENDER_WORKER=on              # "off" para no procesar postales en esta instancia
# RENDER_CONCURRENCY=1          # postales simultáneas por instancia (≈1 por cada 2 vCPU)
# RENDER_MAX_QUEUE=60           # tamaño máximo de la fila antes de pedir reintento
# RENDER_DIR=.data/renders      # dónde se guardan MP4/PNG (volumen persistente)
# RENDER_TTL_HOURS=72           # limpieza automática de archivos
# POSTAL_X264_PRESET=medium     # "veryfast" en servidores pequeños
# FFMPEG_PATH=ffmpeg
# POSTAL_SOURCE_VIDEO=assets/video/everest-original.mp4

{
  "name": "everest-somos",
  "version": "1.0.0",
  "private": true,
  "description": "EVEREST — Nuestra cima, nuestro futuro · Plataforma del evento de SOMOS Miguel Hidalgo",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "assets:video": "bash scripts/prepare-video.sh",
    "assets:lettering": "tsx scripts/build-lettering.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fontkit": "^2.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
